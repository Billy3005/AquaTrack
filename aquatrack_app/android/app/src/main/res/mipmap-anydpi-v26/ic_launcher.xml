<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon (API 26+). Launchers mask the two layers to their own
  shape — circle, squircle, teardrop — and may parallax them, so the artwork
  sits inside the safe middle 66% of the foreground and the gradient plate is
  its own full-bleed layer.

  Pre-26 devices fall back to the flat mipmap-*/ic_launcher.png.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
