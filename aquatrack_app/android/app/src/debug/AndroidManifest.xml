<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Debug-only overrides. Merged into the debug build and nothing else, so
         none of this can reach a release artifact.

         Debug builds point at http://localhost:8001 (see app_config.dart), which
         Android blocks by default since API 28. The release build talks only to
         the HTTPS backend and must keep cleartext off — Play flags it, and it
         would silently permit a downgrade attack on a real user's traffic. -->
    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic" />
</manifest>
